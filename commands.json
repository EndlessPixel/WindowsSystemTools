  "admin": [
    {
      "name": "远程与连接",
      "items": [
        {
          "name": "启用远程桌面",
          "command": "reg add \"HKLM\\SYSTEM\\CurrentControlSet\\Control\\Terminal Server\" /v fDenyTSConnections /t REG_DWORD /d 0 /f"
        },
        {
          "name": "关闭远程桌面",
          "command": "reg add \"HKLM\\SYSTEM\\CurrentControlSet\\Control\\Terminal Server\" /v fDenyTSConnections /t REG_DWORD /d 1 /f"
        },
        {
          "name": "启用无密码连接",
          "command": "reg add \"HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa\" /v LimitBlankPasswordUse /t REG_DWORD /d 0 /f"
        },
        {
          "name": "关闭无密码连接",
          "command": "reg add \"HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa\" /v LimitBlankPasswordUse /t REG_DWORD /d 1 /f"
        },
        {
          "name": "启用远程协助",
          "command": "reg add \"HKLM\\SYSTEM\\CurrentControlSet\\Control\\Terminal Server\\WinStations\\RDP-Tcp\" /v UserAuthentication /t REG_DWORD /d 1 /f && netsh advfirewall firewall set rule group=\"Remote Assistance\" new enable=yes"
        },
        {
          "name": "关闭远程协助",
          "command": "reg add \"HKLM\\SYSTEM\\CurrentControlSet\\Control\\Terminal Server\\WinStations\\RDP-Tcp\" /v UserAuthentication /t REG_DWORD /d 0 /f && netsh advfirewall firewall set rule group=\"Remote Assistance\" new enable=no"
        },
        {
          "name": "设置RDP端口为3389",
          "command": "reg add \"HKLM\\SYSTEM\\CurrentControlSet\\Control\\Terminal Server\\WinStations\\RDP-Tcp\" /v PortNumber /t REG_DWORD /d 3389 /f"
        },
        {
          "name": "限制RDP仅允许NLA",
          "command": "reg add \"HKLM\\SYSTEM\\CurrentControlSet\\Control\\Terminal Server\\WinStations\\RDP-Tcp\" /v UserAuthentication /t REG_DWORD /d 1 /f"
        }
      ]
    },
    {
      "name": "安全防护",
      "items": [
        {
          "name": "启用 Defender",
          "command": "powershell -Command \"Set-MpPreference -DisableRealtimeMonitoring $false\""
        },
        {
          "name": "禁用 Defender",
          "command": "powershell -Command \"Set-MpPreference -DisableRealtimeMonitoring $true\""
        },
        {
          "name": "用于内置管理员帐户的管理员批准模式",
          "command": "reg add \"HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\" /v FilterAdministratorToken /t REG_DWORD /d 1 /f"
        },
        {
          "name": "关闭 Smartscreen 应用筛选器 (旧版)",
          "command": "reg add \"HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\" /v SmartScreenEnabled /t REG_SZ /d off /f"
        },
        {
          "name": "关闭 Smartscreen 应用筛选器 (新版)",
          "command": "reg add \"HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\" /v SmartScreenEnabled /t REG_SZ /d off /f & reg add \"HKLM\\SOFTWARE\\Policies\\Microsoft\\MicrosoftEdge\\PhishingFilter\" /v EnabledV9 /t REG_DWORD /d 0 /f"
        },
        {
          "name": "关闭 UAC",
          "command": "powershell -Command \"Set-ItemProperty -Path HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System -Name EnableLUA -Value 0\""
        },
        {
          "name": "启用 UAC",
          "command": "powershell -Command \"Set-ItemProperty -Path HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System -Name EnableLUA -Value 1\""
        },
        {
          "name": "禁用 Windows 遥测数据收集",
          "command": "reg add \"HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection\" /v AllowTelemetry /t REG_DWORD /d 0 /f"
        },
        {
          "name": "启用 Windows 遥测数据收集",
          "command": "reg add \"HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection\" /v AllowTelemetry /t REG_DWORD /d 3 /f"
        },
        {
          "name": "禁用SMBv1协议",
          "command": "powershell -Command \"Disable-WindowsOptionalFeature -Online -FeatureName SMB1Protocol\""
        },
        {
          "name": "启用SMBv1协议",
          "command": "powershell -Command \"Enable-WindowsOptionalFeature -Online -FeatureName SMB1Protocol\""
        },
        {
          "name": "禁用PowerShell脚本执行",
          "command": "powershell -Command \"Set-ExecutionPolicy Restricted -Force\""
        },
        {
          "name": "启用PowerShell脚本执行",
          "command": "powershell -Command \"Set-ExecutionPolicy RemoteSigned -Force\""
        }
      ]
    },
    {
      "name": "系统服务管理",
      "items": [
        {
          "name": "启用 SysMain",
          "command": "sc config SysMain start= auto && net start SysMain"
        },
        {
          "name": "禁用 SysMain",
          "command": "net stop SysMain && sc config SysMain start= disabled"
        },
        {
          "name": "启用 Windows 索引",
          "command": "sc config WSearch start= auto && net start WSearch"
        },
        {
          "name": "禁用 Windows 索引",
          "command": "net stop WSearch && sc config WSearch start= disabled"
        },
        {
          "name": "禁用家庭组服务",
          "command": "net stop HomeGroupListener && net stop HomeGroupProvider && sc config HomeGroupListener start= disabled && sc config HomeGroupProvider start= disabled"
        },
        {
          "name": "启用家庭组服务",
          "command": "sc config HomeGroupListener start= auto && sc config HomeGroupProvider start= auto && net start HomeGroupListener && net start HomeGroupProvider"
        },
        {
          "name": "启用自动更新",
          "command": "sc config wuauserv start= auto && net start wuauserv"
        },
        {
          "name": "停止自动更新",
          "command": "net stop wuauserv && sc config wuauserv start= disabled"
        },
        {
          "name": "启用自动时间同步",
          "command": "sc config w32time start= auto && net start w32time"
        },
        {
          "name": "禁用自动时间同步",
          "command": "net stop w32time && sc config w32time start= disabled"
        },
        {
          "name": "启用打印后台处理",
          "command": "sc config Spooler start= auto && net start Spooler"
        },
        {
          "name": "禁用打印后台处理",
          "command": "net stop Spooler && sc config Spooler start= disabled"
        }
      ]
    },
    {
      "name": "系统维护清理",
      "items": [
        {
          "name": "清空回收站",
          "command": "powershell -NoProfile -Command \"Get-ChildItem -Path C:\\$Recycle.Bin -Force -Recurse | Remove-Item -Recurse -Force\""
        },
        {
          "name": "清理系统临时文件",
          "command": "powershell -Command \"Get-ChildItem -Path $env:TEMP -Recurse | Remove-Item -Force -Recurse -ErrorAction SilentlyContinue\""
        },
        {
          "name": "清理 WinTemp",
          "command": "powershell -Command \"Remove-Item -Path C:\\Windows\\Temp\\* -Recurse -Force -ErrorAction SilentlyContinue\""
        },
        {
          "name": "磁盘碎片整理C：",
          "command": "defrag C: /U /V"
        },
        {
          "name": "优化磁盘C：",
          "command": "defrag C: /O"
        },
        {
          "name": "清理 Windows 更新缓存",
          "command": "powershell -Command \"Stop-Service wuauserv; Remove-Item -Path C:\\Windows\\SoftwareDistribution\\Download\\* -Recurse -Force -ErrorAction SilentlyContinue; Start-Service wuauserv\""
        },
        {
          "name": "禁用 Windows 错误报告",
          "command": "reg add \"HKLM\\SOFTWARE\\Microsoft\\Windows\\Windows Error Reporting\" /v Disabled /t REG_DWORD /d 1 /f"
        },
        {
          "name": "启用 Windows 错误报告",
          "command": "reg add \"HKLM\\SOFTWARE\\Microsoft\\Windows\\Windows Error Reporting\" /v Disabled /t REG_DWORD /d 0 /f"
        },
        {
          "name": "禁用系统还原",
          "command": "powershell Disable-ComputerRestore -Drive C:\\"
        },
        {
          "name": "启用系统还原",
          "command": "powershell Enable-ComputerRestore -Drive C:\\"
        },
        {
          "name": "清理组件存储(无破坏)",
          "command": "dism /Online /Cleanup-Image /StartComponentCleanup"
        },
        {
          "name": "扫描系统组件完整性",
          "command": "dism /Online /Cleanup-Image /ScanHealth"
        },
        {
          "name": "修复系统组件",
          "command": "dism /Online /Cleanup-Image /RestoreHealth"
        },
        {
          "name": "修复系统文件",
          "command": "sfc /scannow"
        }
      ]
    },
    {
      "name": "系统进程管理",
      "items": [
        {
          "name": "重启资源管理器",
          "command": "taskkill /im explorer.exe /f && start explorer.exe"
        },
        {
          "name": "杀死资源管理器",
          "command": "taskkill /im explorer.exe /f"
        },
        {
          "name": "启动资源管理器",
          "command": "start explorer.exe"
        },
        {
          "name": "杀死命令提示符",
          "command": "taskkill /im cmd.exe /f"
        },
        {
          "name": "结束无响应任务",
          "command": "powershell -Command \"Get-Process | Where-Object { $_.Responding -eq $false } | Stop-Process -Force\""
        }
      ]
    },
    {
      "name": "系统启动设置",
      "items": [
        {
          "name": "禁用快速启动",
          "command": "powercfg /h off"
        },
        {
          "name": "启用快速启动",
          "command": "powercfg /h on"
        },
        {
          "name": "禁用应用自动启动",
          "command": "reg add \"HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run\" /f && reg add \"HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run\" /f"
        },
        {
          "name": "启用应用自动启动",
          "command": "echo 需手动配置注册表项恢复自动启动程序"
        },
        {
          "name": "禁用休眠功能",
          "command": "powercfg /hibernate off"
        },
        {
          "name": "启用休眠功能",
          "command": "powercfg /hibernate on"
        },
        {
          "name": "启用传统登录界面",
          "command": "reg add \"HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\" /v dontdisplaylastusername /t REG_DWORD /d 0 /f"
        },
        {
          "name": "禁用传统登录界面",
          "command": "reg add \"HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\" /v dontdisplaylastusername /t REG_DWORD /d 1 /f"
        }
      ]
    },
    {
      "name": "网络管理配置",
      "items": [
        {
          "name": "刷新 DNS",
          "command": "ipconfig /flushdns"
        },
        {
          "name": "释放 IP",
          "command": "ipconfig /release"
        },
        {
          "name": "重新获取 IP",
          "command": "ipconfig /renew"
        },
        {
          "name": "重启 DNS 缓存",
          "command": "net stop dnscache && net start dnscache"
        },
        {
          "name": "禁用网络发现",
          "command": "reg add \"HKLM\\SYSTEM\\CurrentControlSet\\Services\\LanmanServer\\Parameters\" /v AutoShareServer /t REG_DWORD /d 0 /f && reg add \"HKLM\\SYSTEM\\CurrentControlSet\\Services\\LanmanWorkstation\\Parameters\" /v DisallowUnencryptedGuestAuth /t REG_DWORD /d 1 /f"
        },
        {
          "name": "启用网络发现",
          "command": "reg add \"HKLM\\SYSTEM\\CurrentControlSet\\Services\\LanmanServer\\Parameters\" /v AutoShareServer /t REG_DWORD /d 1 /f && reg add \"HKLM\\SYSTEM\\CurrentControlSet\\Services\\LanmanWorkstation\\Parameters\" /v DisallowUnencryptedGuestAuth /t REG_DWORD /d 0 /f"
        },
        {
          "name": "重置 Winsock",
          "command": "netsh winsock reset"
        },
        {
          "name": "重置 TCP/IP 协议栈",
          "command": "netsh int ip reset"
        },
        {
          "name": "查看所有网络连接",
          "command": "netstat -ano"
        },
        {
          "name": "显示ARP缓存表",
          "command": "arp -a"
        },
        {
          "name": "显示路由表",
          "command": "route print"
        }
      ]
    },
    {
      "name": "Windows 更新设置",
      "items": [
        {
          "name": "禁用自动更新驱动",
          "command": "reg add \"HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DriverSearching\" /v DontSearchWindowsUpdate /t REG_DWORD /d 1 /f && reg add \"HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DriverSearching\" /v SearchOrderConfig /t REG_DWORD /d 0 /f"
        },
        {
          "name": "启用自动更新驱动",
          "command": "reg delete \"HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DriverSearching\" /v DontSearchWindowsUpdate /f && reg delete \"HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DriverSearching\" /v SearchOrderConfig /f"
        },
        {
          "name": "暂停Windows更新7天",
          "command": "powershell -Command \"Set-ItemProperty -Path HKLM:\\SOFTWARE\\Microsoft\\WindowsUpdate\\UX\\Settings -Name PauseUpdatesExpiryTime -Value (Get-Date).AddDays(7).ToString()\""
        },
        {
          "name": "恢复Windows更新",
          "command": "powershell -Command \"Remove-ItemProperty -Path HKLM:\\SOFTWARE\\Microsoft\\WindowsUpdate\\UX\\Settings -Name PauseUpdatesExpiryTime\""
        }
      ]
    },
    {
      "name": "时间与时区管理",
      "items": [
        {
          "name": "同步 Internet 时间",
          "command": "w32tm /resync"
        },
        {
          "name": "查看当前时区",
          "command": "tzutil /g"
        },
        {
          "name": "设为北京时区",
          "command": "tzutil /s \"China Standard Time\""
        },
        {
          "name": "设为香港时区",
          "command": "tzutil /s \"China Standard Time\""
        },
        {
          "name": "设为UTC时区",
          "command": "tzutil /s \"UTC\""
        }
      ]
    },
    {
      "name": "视觉效果设置",
      "items": [
        {
          "name": "低质量壁纸",
          "command": "reg add \"HKCU\\Control Panel\\Desktop\" /v JPEGImportQuality /t REG_DWORD /d 96 /f"
        },
        {
          "name": "默认质量壁纸",
          "command": "reg delete \"HKCU\\Control Panel\\Desktop\" /v JPEGImportQuality /f"
        },
        {
          "name": "高质量壁纸",
          "command": "reg add \"HKCU\\Control Panel\\Desktop\" /v JPEGImportQuality /t REG_DWORD /d 256 /f"
        },
        {
          "name": "调整为最佳性能",
          "command": "powershell -Command \"Set-ItemProperty -Path HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\VisualEffects -Name VisualFXSetting -Value 2\""
        },
        {
          "name": "恢复为系统默认视觉效果",
          "command": "powershell -Command \"Remove-ItemProperty -Path HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\VisualEffects -Name VisualFXSetting\""
        }
      ]
    },
    {
      "name": "安全扫描",
      "items": [
        {
          "name": "全盘扫描",
          "command": "powershell -Command \"Start-MpScan -ScanType FullScan\""
        },
        {
          "name": "快速扫描",
          "command": "powershell -Command \"Start-MpScan -ScanType QuickScan\""
        },
        {
          "name": "更新Defender病毒库",
          "command": "powershell -Command \"Update-MpSignature\""
        }
      ]
    },
    {
      "name": "系统还原",
      "items": [
        {
          "name": "创建还原点",
