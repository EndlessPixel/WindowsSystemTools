          "command": "powershell -Command \"Get-Partition\""
        },
        {
          "name": "查看磁盘使用情况",
          "command": "powershell -Command \"Get-PSDrive -PSProvider FileSystem | Select-Object Name, @{Name='Used(GB)';Expression={[math]::Round($_.Used/1GB,2)}}, @{Name='Free(GB)';Expression={[math]::Round($_.Free/1GB,2)}}\""
        },
        {
          "name": "优化所有磁盘",
          "command": "powershell -Command \"Optimize-Volume -DriveLetter C,D,E -ReTrim -Verbose\""
        }
      ]
