        }
      ]
    },
    {
      "name": "电源管理",
      "items": [
        {
          "name": "设置为高性能电源计划",
          "command": "powercfg -setactive 8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c"
        },
        {
          "name": "设置为平衡电源计划",
          "command": "powercfg -setactive 381b4222-f694-41f0-9685-ff5bb260df2e"
        },
        {
          "name": "设置为节能电源计划",
          "command": "powercfg -setactive a1841308-3541-4fab-bc81-f71556f20b4a"
        },
        {
          "name": "查看当前电源计划",
          "command": "powercfg /getactivescheme"
        },
        {
          "name": "禁用显示器睡眠",
          "command": "powercfg -change -monitor-timeout-ac 0"
        },
        {
          "name": "启用显示器睡眠(15分钟)",
          "command": "powercfg -change -monitor-timeout-ac 15"
        }
      ]
